        <mxCell id="text_incloud_dns" value="&lt;b&gt;nordly InCloud DNS&lt;/b&gt;&lt;br&gt;Forward lookup zone: nordly.local → InCloud DNS-servere (outbound ruleset på dnspr-hub-prod)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="-692" y="2327" width="600" height="45" as="geometry" /></mxCell>
