        <mxCell id="text_incloud_sql" value="&lt;b&gt;sql01.nordly.local&lt;/b&gt;&lt;br&gt;TCP 1433 — SQL Server on-prem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="-692" y="2387" width="600" height="45" as="geometry" /></mxCell>
