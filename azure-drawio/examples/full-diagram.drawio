        <mxCell id="text_incloud_fil" value="&lt;b&gt;fil01.nordly.local&lt;/b&gt;&lt;br&gt;TCP 445 — SMB filshare" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="-692" y="2447" width="600" height="45" as="geometry" /></mxCell>
        <mxCell id="arr_client_agw" value="HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=11;edgeStyle=orthogonalEdgeStyle;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="client_box" target="online_gw_vnet"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr_peer_online_gw_online_wl" value="VNet peering (direkte) — AGW → backend" style="endArrow=none;startArrow=none;html=1;rounded=0;dashed=1;dashPattern=6 3;strokeColor=#888888;strokeWidth=1.5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="online_gw_sub" target="online_wl_sub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr_peer_online_gw_conn" value="VNet peering" style="endArrow=none;startArrow=none;html=1;rounded=0;dashed=1;dashPattern=6 3;strokeColor=#888888;strokeWidth=1.5;fontSize=10;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="online_gw_sub" target="conn_sub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-790" y="600" /><mxPoint x="-790" y="1010" /></Array></mxGeometry></mxCell>
        <mxCell id="arr_peer_online_wl_conn" value="VNet peering" style="endArrow=none;startArrow=none;html=1;rounded=0;dashed=1;dashPattern=6 3;strokeColor=#888888;strokeWidth=1.5;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="online_wl_sub" target="conn_sub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="arr_peer_corp_conn" value="VNet peering" style="endArrow=none;startArrow=none;html=1;rounded=0;dashed=1;dashPattern=6 3;strokeColor=#888888;strokeWidth=1.5;fontSize=10;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="conn_sub" target="corp_sub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-820" y="1485" /><mxPoint x="-820" y="1720" /></Array></mxGeometry></mxCell>
        <mxCell id="arr_vpng_incloud" value="Direct Link / S2S VPN" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#565776;strokeWidth=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" edge="1" parent="1" source="icon_vpng" target="incloud_box"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-900" y="1165" /><mxPoint x="-900" y="2363" /></Array></mxGeometry></mxCell>
        <mxCell id="notes_header" value="Notater" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#007375;strokeColor=#007375;strokeWidth=2;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;fontStyle=1;fontColor=#ffffff;fontFamily=Satoshi Intility, Satoshi, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="540" height="40" as="geometry" /></mxCell>
        <mxCell id="notes_0" value="&lt;b&gt;1. Nettverk&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Region: norwayeast. Hub-and-spoke — spoke peerer kun mot hub, aldri mot hverandre.&lt;/li&gt;&lt;li&gt;vnet-shared-agw-prod 10.0.0.0/23 · snet-agw /24 (anbefalt for autoskalering av WAF_v2)&lt;/li&gt;&lt;li&gt;vnet-kundeportal-online-prod 10.1.0.0/22 · vnet-kundeportal-corp-prod 10.20.0.0/22 · vnet-hub-prod 10.10.0.0/22&lt;/li&gt;&lt;li&gt;NSG på alle subnet unntatt GatewaySubnet (ikke støttet/anbefalt).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="225" width="540" height="111" as="geometry" /></mxCell>
        <mxCell id="notes_1" value="&lt;b&gt;2. SKU-valg&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Application Gateway WAF_v2 — eneste SKU med WAF og autoskalering.&lt;/li&gt;&lt;li&gt;VPN Gateway VpnGw2AZ — sonefordelt, krav i prod.&lt;/li&gt;&lt;li&gt;Container Registry Premium — kreves for private endpoint.&lt;/li&gt;&lt;li&gt;SQL General Purpose sonefordelt · Storage Standard_ZRS.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="341" width="540" height="96" as="geometry" /></mxCell>
        <mxCell id="notes_2" value="&lt;b&gt;3. Backup/DR&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Key Vault: soft-delete + purge protection påkrevd.&lt;/li&gt;&lt;li&gt;SQL: PITR 7 dager, ukentlig LTR 12 mnd. RPO 1t / RTO 4t.&lt;/li&gt;&lt;li&gt;Storage: versjonering + soft-delete 30 dager.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="442" width="540" height="81" as="geometry" /></mxCell>
        <mxCell id="notes_3" value="&lt;b&gt;4. Identitet/Auth&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;id-kundeportal-prod → Key Vault Secrets User på kv-kundeportal-prod&lt;/li&gt;&lt;li&gt;id-kundeportal-prod → AcrPull på crkundeportalprod&lt;/li&gt;&lt;li&gt;Ingen service principals eller secrets i bruk — kun Managed Identity.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="528" width="540" height="81" as="geometry" /></mxCell>
        <mxCell id="notes_4" value="&lt;b&gt;5. DNS&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Alle privatelink-soner ligger i nordly-connectivity og er lenket til alle tre spoke-VNet.&lt;/li&gt;&lt;li&gt;ACR: kun privatelink.azurecr.io. Det regionale data-endepunktet blir egne poster i samme sone med Azure Private DNS — ikke en egen sone.&lt;/li&gt;&lt;li&gt;Azure Monitor via AMPLS krever alle fire soner + blob-sonen.&lt;/li&gt;&lt;li&gt;A-record portal.nordly.no → pip-agw-shared-prod må opprettes i offentlig DNS.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="614" width="540" height="111" as="geometry" /></mxCell>
        <mxCell id="notes_5" value="&lt;b&gt;6. Application Gateway&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;WAF Policy OWASP 3.2, Prevention mode.&lt;/li&gt;&lt;li&gt;AGW-VNet peeres DIREKTE mot workload-VNet. Peering er ikke-transitiv — via hub alene når ikke AGW backend-poolen. Trafikken går da utenom sentral brannmurinspeksjon.&lt;/li&gt;&lt;li&gt;Sertifikatkjede: Intility ACME utsteder → lagres i kv-cert-prod i nordly-management → AGW leser via managed identity (Key Vault Secrets User).&lt;/li&gt;&lt;li&gt;App Service Managed Certificate er ikke støttet bak AGW — bekreftet mot Microsoft Learn.&lt;/li&gt;&lt;li&gt;Backend pool peker på pe-app-kundeportal-prod (privat IP), ikke offentlig endepunkt.&lt;/li&gt;&lt;li&gt;kv-cert har OFFENTLIG endepunkt — Intility ACME bruker ikke privat nettverk. Bevisst unntak fra private-by-default; kompenserende kontroller (KV-brannmur, RBAC) må bekreftes.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="730" width="540" height="171" as="geometry" /></mxCell>
        <mxCell id="notes_6" value="&lt;b&gt;7. Intility InCloud&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;sql01.nordly.local — TCP 1433 fra snet-app&lt;/li&gt;&lt;li&gt;fil01.nordly.local — TCP 445 fra snet-app&lt;/li&gt;&lt;li&gt;Brannmurregler må åpnes begge veier over Direct Link.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="906" width="540" height="81" as="geometry" /></mxCell>
        <mxCell id="notes_7" value="&lt;b&gt;8. Åpne spørsmål&lt;/b&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Skal test-/QA-miljø dele hub, eller ha egen connectivity-subscription?&lt;/li&gt;&lt;li&gt;Er 10.20.0.0/22 ledig i kundens IP-plan?&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d3d3df;strokeWidth=2;fontSize=10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontColor=#071627;fontFamily=Open Sans, Helvetica, Arial, sans-serif;" vertex="1" parent="1"><mxGeometry x="400" y="992" width="540" height="66" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
